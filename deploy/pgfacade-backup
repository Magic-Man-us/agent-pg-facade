#!/usr/bin/env bash
set -euo pipefail
umask 077

readonly BACKUP_DIRECTORY=/var/backups/pgfacade
readonly PUBLIC_CERTIFICATE=/etc/pgfacade/backup-public.pem
readonly RETAINED_DAYS=7
readonly SOCKET_DIRECTORY=/var/run/postgresql
readonly DATABASE=pgfacade

if (( EUID != 0 )); then
    logger --tag pgfacade-backup --priority user.err 'Backup must run as root'
    exit 1
fi

install -d -o root -g root -m 0700 "$BACKUP_DIRECTORY"
exec 9>"$BACKUP_DIRECTORY/.lock"
flock --nonblock 9 || exit 0

readonly BACKUP_DATE=$(date --utc +%F)
readonly BACKUP_FILE="$BACKUP_DIRECTORY/pgfacade-$BACKUP_DATE.dump.cms"
backup_temporary=$(mktemp "$BACKUP_DIRECTORY/.pgfacade-$BACKUP_DATE.XXXXXX")
cleanup() {
    backup_status=$?
    rm -f -- "$backup_temporary"
    if (( backup_status != 0 )); then
        logger --tag pgfacade-backup --priority user.err 'Encrypted database backup failed'
    fi
}
trap cleanup EXIT

runuser -u postgres -- /usr/bin/pg_dump --host="$SOCKET_DIRECTORY" --dbname="$DATABASE" --format=custom \
    | openssl cms -encrypt -binary -aes-256-gcm -stream -outform DER \
        -out "$backup_temporary" "$PUBLIC_CERTIFICATE"

test -s "$backup_temporary"
chmod 0600 "$backup_temporary"
mv -f -- "$backup_temporary" "$BACKUP_FILE"

mapfile -t backup_obsolete < <(
    find "$BACKUP_DIRECTORY" -regextype posix-extended -maxdepth 1 -type f \
        -regex '.*/pgfacade-[0-9]{4}-[0-9]{2}-[0-9]{2}\.dump\.cms' -printf '%f\n' \
        | sort --reverse | tail -n "+$((RETAINED_DAYS + 1))"
)
for backup_name in "${backup_obsolete[@]}"; do
    rm -- "$BACKUP_DIRECTORY/$backup_name"
done
logger --tag pgfacade-backup "Encrypted backup completed: $BACKUP_FILE"
