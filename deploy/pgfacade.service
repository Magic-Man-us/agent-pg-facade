[Unit]
Description=Restricted local PGFacade API
After=postgresql@16-main.service
Requires=postgresql@16-main.service
PartOf=postgresql@16-main.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=pgfacade
Group=pgfacade
WorkingDirectory=/opt/pgfacade
EnvironmentFile=/etc/pgfacade/service.conf
Environment=PGFACADE_KEYS_FILE=%d/api-keys
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=api-keys:/etc/pgfacade/keys.json
ExecStart=/opt/pgfacade/.venv/bin/python -m uvicorn pgfacade.webapp:create_app --factory --host 127.0.0.1 --port 8765 --limit-concurrency 32 --limit-max-requests 10000 --timeout-keep-alive 5 --no-access-log
Restart=always
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=pgfacade
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
TasksMax=128
MemoryHigh=384M
MemoryMax=512M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
