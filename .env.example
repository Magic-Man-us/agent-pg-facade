PGFACADE_DSN=postgresql://pgfacade_svc:password@localhost:5432/postgres
PGFACADE_DEFAULT_SCHEMA=public
PGFACADE_APPLICATION_NAME=pgfacade

PGFACADE_POOL_MIN=1
PGFACADE_POOL_MAX=10
PGFACADE_POOL_TIMEOUT_S=30

PGFACADE_STATEMENT_TIMEOUT_MS=30000
PGFACADE_LOCK_TIMEOUT_MS=5000
PGFACADE_SCHEMA_CACHE_TTL_S=60

PGFACADE_MAX_ROWS=1000
PGFACADE_MAX_EXPORT_ROWS=100000
PGFACADE_MAX_WAIT_S=60

# Server-wide caps; no key can exceed these
PGFACADE_READ_ONLY=false
PGFACADE_ALLOW_RAW_SQL=true
PGFACADE_ALLOW_DDL=true
PGFACADE_ALLOW_ADMIN=false
PGFACADE_ALLOW_MIGRATE=true
PGFACADE_ALLOW_LISTEN=true

# Access keys: inline JSON, a file, or both (inline wins). Generate keys with `pgfacade keygen`.
# Leave both unset to run without auth (every caller is the connector user).
PGFACADE_KEYS={"replace-me-admin":{"name":"dba","sql":true,"admin":true,"migrate":true},"replace-me-reader":{"name":"claude","role":"app_reader","read_only":true}}
# PGFACADE_KEYS_FILE=/etc/pgfacade/keys.json

# Key the stdio MCP server runs as (HTTP transport reads Authorization: Bearer instead)
# PGFACADE_MCP_KEY=replace-me-reader

PGFACADE_MIGRATIONS_DIR=migrations
# In-process TTL sweeper interval; 0 disables (schedule _pgfacade.run_lifecycle() with pg_cron instead)
PGFACADE_LIFECYCLE_SWEEP_S=60
# NOTIFY channel run_lifecycle() reports on when a policy changed rows or failed
PGFACADE_LIFECYCLE_CHANNEL=pgfacade_lifecycle

# Your own *.sql queries, merged over the built-in catalog (see src/pgfacade/queries/sql for the format)
# PGFACADE_QUERIES_DIR=queries
